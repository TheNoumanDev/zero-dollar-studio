+class _FixedBoxFace:
+    """Stand-in for an InsightFace detection: a fixed face box in a pre-cropped square.
+
+    LivePortrait only uses the detector's 106 points as a starting region for its own
+    (MIT) landmark model, which then finds the real landmarks. Our sources and driving
+    clips are face-centred squares, so a fixed box (x 22-78%, y 18-88%) is enough.
+    """
+
+    def __init__(self, img):
+        h, w = img.shape[:2]
+        xs = np.linspace(0.22 * w, 0.78 * w, 106)
+        ys = np.concatenate([np.linspace(0.18 * h, 0.88 * h, 53), np.linspace(0.88 * h, 0.18 * h, 53)])
+        self.landmark_2d_106 = np.stack([xs, ys], axis=1).astype(np.float32)
+
+
+def _fixed_box_faces(img_bgr):
+    return [_FixedBoxFace(img_bgr)]
+
+
